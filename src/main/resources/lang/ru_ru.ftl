self-kick-with-reason = { $player } кикнул себя с сервера по этой причине: { $reason }
    .item-1 = { $player } кикнул себя, и причиной неожиданно оказалось: { $reason }
    .item-2 = { $player } действительно кикнул себя с сервера из-за { $reason }!
    .item-3 = { $player } добровольно покинул сервер, оставив такое объяснение: { $reason }
    .item-4 = { $player } выбрал самокик: { $reason }
self-kick-without-reason = { $player } кикнул себя с сервера.
    .item-1 = { $player } умудрился кикнуть самого себя!
    .item-2 = { $player } молча покинул сервер.
    .item-3 = { $player } безупречно исполнил самокик.
    .item-4 = { $player } собственноручно нажал кнопку выхода с сервера.
