social-command-usage = Questo comando non richiede argomenti. Invia:
social-duration-days = { $arg0 ->
        [one] { $arg0 } giorno
       *[other] { $arg0 } giorni
    } { $arg1 ->
        [one] { $arg1 } ora
       *[other] { $arg1 } ore
    } { $arg2 ->
        [one] { $arg2 } minuto
       *[other] { $arg2 } minuti
    }
