# /etc/mikd/secrets.env: uncomment only the credentials you use.

# QQ bot.
# MIKD_QQ_APP_SECRET=

# QQ moderation: OVH uses anonymous access without a key; Eden requires a key.
# MIKD_QQ_OVH_API_KEY=
# MIKD_QQ_EDEN_API_KEY=

# Matrix: store passphrase, first-login password, optional recovery key.
# MIKD_MATRIX_STORE_PASSPHRASE=
# MIKD_MATRIX_PASSWORD=
# MIKD_MATRIX_RECOVERY_KEY=

# AI provider key, if required.
# MIKD_MODEL_API_KEY=
# MIKD_TAVILY_API_KEY=
